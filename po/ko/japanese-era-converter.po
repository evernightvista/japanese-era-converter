#: src/japaneserunner.cpp:20
msgid "Converts the Gregorian year :q: (1910-2099) to the Japanese era"
msgstr "서기 :q:년(1910-2099)을 일본 연호로 변환합니다"

#: src/japaneserunner.cpp:24
msgid "Converts a Japanese era year (e.g. 令和8年 / Reiwa 8) to the Gregorian year"
msgstr "일본 연호 연도(예: 令和8년 / Reiwa 8)를 서기 연도로 변환합니다"

#: src/japaneserunner.cpp:52
msgid "Gregorian year %1 → click to copy to clipboard"
msgstr "서기 %1년 → 클릭하여 클립보드에 복사"

#: src/japaneserunner.cpp:67
msgid "%1%2 → click to copy Gregorian year to clipboard"
msgstr "%1%2 → 클릭하여 서기 연도를 클립보드에 복사"
